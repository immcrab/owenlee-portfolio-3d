# Required to generate real AI summaries when running `npm run generate:repos`.
# Get a key at https://console.mistral.ai
MISTRAL_API_KEY=

# Optional: raises the GitHub API rate limit (60/hr unauthenticated -> 5000/hr).
# A classic PAT with no scopes is enough for public repos.
GITHUB_TOKEN=

# Optional overrides.
GITHUB_USER=immcrab
MAX_REPOS=30
MISTRAL_MODEL=mistral-small-latest
